# The public origin this site is served from.
#
# Every embed tag the builder generates points here, so it must be the domain
# visitors actually load. On Vercel a preview deploy falls back to VERCEL_URL
# automatically; set this explicitly once you have a custom domain.
#
# NEXT_PUBLIC_ is required — this is read during client rendering, and anything
# without the prefix is stripped from the browser bundle.
NEXT_PUBLIC_SITE_ORIGIN=https://your-domain.com
