{
  "manifest_version": 3,
  "name": "CursorKit — custom cursors for any site",
  "version": "0.1.0",
  "description": "Put any of 127 hand-built cursors on any website. Pick a style, tune it live, and turn it off per site.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CursorKit",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "engine.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
